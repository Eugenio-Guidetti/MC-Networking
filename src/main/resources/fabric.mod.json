{
  "schemaVersion": 1,
  "id": "mc-networking",
  "version": "${version}",
  "name": "MC Networking",
  "description": "Mod di Minecraft per simulare reti IP nel gioco",
  "authors": [
    "Eugenio Guidetti"
  ],
  "contact": {
    "homepage": "https://www.eugenioguidetti.eu/progetti/mc-networking/",
    "sources": "https://github.com/Eugenio-Guidetti/MC-Networking",
    "issues": "https://github.com/eugenio-guidetti/mc-networking/issues"
  },
  "license": "MIT",
  "icon": "assets/mc-networking/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "eu.eugenioguidetti.mcnetworking.MCNetworking",
      "eu.eugenioguidetti.mcnetworking.terminal.initializers.ServerTerminalPacketsInitializer"
    ],
    "client": [
      "eu.eugenioguidetti.mcnetworking.client.rendering.CablesRenderPipeline",
      "eu.eugenioguidetti.mcnetworking.terminal.initializers.ClientTerminalPacketsInitializer"
    ],
    "fabric-datagen": [
      "eu.eugenioguidetti.mcnetworking.datagen.MCNetworkingDataGenerator"
    ]
  },
  "mixins": [
    "mc-networking.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}